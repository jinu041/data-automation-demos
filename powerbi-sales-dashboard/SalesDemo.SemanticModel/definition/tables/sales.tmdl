	partition sales = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFile), [Delimiter=",", Columns=12, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"OrderID", type text}, {"OrderDate", type date}, {"Month", type date}, {"Region", type text}, {"Channel", type text}, {"Category", type text}, {"Product", type text}, {"Units", Int64.Type}, {"UnitPrice", type number}, {"UnitCost", type number}, {"Revenue", type number}, {"Cost", type number}}),
				    Labeled = Table.AddColumn(Typed, "MonthLabel", each Date.ToText([Month], [Format="MMM yyyy", Culture="en-US"]), type text)
				in
				    Labeled

	annotation PBI_ResultType = Table

