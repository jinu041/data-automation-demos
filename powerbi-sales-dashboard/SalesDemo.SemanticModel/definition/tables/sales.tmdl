table sales
	lineageTag: 0f221804-7b2e-54c1-8e83-17a0bb3cad6b

	measure 'Total Revenue' = SUM(sales[Revenue])
		formatString: \$#,0
		lineageTag: b86879ec-70fd-5ea9-98a7-bb3157b094a6

	measure 'Gross Margin %' = DIVIDE([Total Revenue] - SUM(sales[Cost]), [Total Revenue])
		formatString: 0.0%
		lineageTag: 9b78cca8-ebf7-5193-a163-9dfa128ecd04

	measure Orders = DISTINCTCOUNT(sales[OrderID])
		formatString: #,0
		lineageTag: 7c22ff22-ea6c-5220-bffd-7b42e5ddae22

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Orders])
		formatString: \$#,0.00
		lineageTag: 228d70ef-2021-5c96-81f7-d89e1d7fd88b

	column OrderID
